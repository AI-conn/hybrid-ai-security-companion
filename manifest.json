{
  "manifest_version": 3,
  "name": "Hybrid AI Security Companion",
  "version": "1.0.0",
  "description": "On-device AI for security researchers. Summarizes reports, drafts attack scenarios, redacts PII — private by default via Gemini Nano 4.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://*.firebaseapp.com/*", "https://*.googleapis.com/*"],
  "action": {
    "default_popup": "public/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "public/options.html",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}